# 1. Specifically force index.html to the root
/index.html      /                301!

# 2. Force all .html pages to their clean versions (The "!" is the secret sauce)
/*.html          /:splat          301!

# 3. Handle subdirectories (like your /guide/ or /location/ folders)
/guide/*.html    /guide/:splat    301!
/location/*.html /location/:splat 301!
